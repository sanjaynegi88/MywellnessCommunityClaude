# ---------- Core ----------
NODE_ENV=production
PORT=8080
PUBLIC_BASE_URL=https://api.mywellnesscommunity.com
SITE_URL=https://mywellnesscommunity.com
SITE_ORIGINS=https://mywellnesscommunity.com,https://www.mywellnesscommunity.com
# PostgreSQL in production (SQLite is used when DB_CLIENT=better-sqlite3)
DB_CLIENT=pg
DATABASE_URL=postgres://mwc:CHANGE_ME@db:5432/mwc360
IP_HASH_SALT=CHANGE_ME_random_string
LOG_LEVEL=info

# ---------- AI (Anthropic) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_QUICK_MODEL=claude-haiku-5-5
AI_MOCK=0

# ---------- Automation ----------
AUTOMATION_ENABLED=true
TZ_SCHEDULE=Europe/London
SHORTLIST_SCORE=70
AUTO_REJECT_SCORE=25
AUTO_PUBLISH_INFORMATIONAL=false
DISCOVERY_COUNTRIES=US,GB,DE
AD_KEYWORDS=joint supplement,dog joint,magnesium,gut health,probiotic for dogs,collagen,sleep supplement,cat food
AD_COUNTRIES=DE,FR,NL,IE
CHAT_IDLE_MINUTES=20
# RUN_SCHEDULER=true   # only for single-process deployments (otherwise run `npm run worker`)

# ---------- Affiliate networks (read-only access) ----------
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
DIGISTORE24_API_KEY=
CLICKBANK_API_KEY=
CLICKBANK_ACCOUNT=
CLICKBANK_FEED_ENABLED=true
CLICKBANK_FEED_URL=https://accounts.clickbank.com/feeds/marketplace_feed_v2.xml.zip

# ---------- WordPress ----------
WP_BASE_URL=https://mywellnesscommunity.com
WP_USER=
WP_APP_PASSWORD=
# Theme menu location the AI-built navigation is assigned to (Appearance → Menus)
WP_MENU_LOCATION=primary

# ---------- Email (MailerLite) ----------
MAILERLITE_API_KEY=
MAILERLITE_WEBHOOK_SECRET=
EMAIL_FROM=hello@mywellnesscommunity.com

# ---------- Social ----------
META_ACCESS_TOKEN=
META_PAGE_ID=
META_PAGE_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v21.0
PINTEREST_TOKEN=
PINTEREST_BOARD_ID=

# TikTok (Commercial Content API for ad research; Content Posting API for videos)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ADLIB_ENABLED=false
TIKTOK_AD_COUNTRIES=DE,FR,NL,IE
TIKTOK_REFRESH_TOKEN=
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
# YouTube (API key for channel research; OAuth for Shorts uploads)
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=public
# Reddit (read-only community research)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:mwc360-research:1.0 (by /u/YOUR_REDDIT_USER)
COMMUNITY_KEYWORDS=dog health,senior dogs,cat health,pet nutrition,supplements,gut health,sleep,joint pain,healthy aging

# ---------- Video ----------
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_TTS=false
VIDEO_TTS_VOICE=en-GB-Neural2-C
# FFMPEG_PATH=ffmpeg

# ---------- Google ----------
# Path to the service-account JSON file, or the JSON itself
GOOGLE_SERVICE_ACCOUNT_JSON=/run/secrets/google-sa.json
GA4_PROPERTY_ID=
GSC_SITE_URL=sc-domain:mywellnesscommunity.com
